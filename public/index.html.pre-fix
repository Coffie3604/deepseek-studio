<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
<meta name="theme-color" content="#0d1117" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="DeepSeek Studio" />
<meta name="mobile-web-app-capable" content="yes" />
<link rel="manifest" href="/manifest.json" />
<link rel="icon" type="image/svg+xml" href="/icon-v2.svg" />
<link rel="apple-touch-icon" href="/icon-v2.svg" />
<title>DeepSeek Studio</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@xterm/xterm@5.5.0/css/xterm.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<link rel="stylesheet" href="/app.css" />

<!-- ═══════════ v2.3 additions (copy everywhere + log + chat search + git records) ═══════════ -->
<style>
/* Copy buttons — always visible (faint by default) */
.copy-btn {
  display: inline-flex; align-items: center; justify-content: center;
  gap: 4px; padding: 3px 8px;
  border: 1px solid var(--border); background: var(--bg-2); color: var(--fg-3);
  border-radius: 5px; font-size: 10px; font-family: inherit; cursor: pointer;
  transition: all .15s ease; -webkit-tap-highlight-color: transparent;
  user-select: none; min-height: 22px;
}
.copy-btn:hover, .copy-btn:active { background: var(--bg-3); color: var(--fg-1); border-color: var(--border-2); }
.copy-btn.copied { color: var(--green); border-color: var(--green); background: rgba(63,185,80,.12); }
.copy-btn svg { display: block; pointer-events: none; }

.tool-call .tool-head { position: relative; padding-right: 60px; }
.tool-call .tool-head .tool-copy { position: absolute; top: -2px; right: 0; }
.tool-call .tool-output { position: relative; }
.tool-call .tool-output .output-copy { position: absolute; top: 6px; right: 6px; z-index: 2; }

.chat-msg.assistant pre .pre-actions {
  position: absolute; top: 8px; right: 8px;
  display: flex; gap: 6px; z-index: 2;
}
.chat-msg.assistant pre .pre-actions .insert-code-btn { position: static; }
.chat-msg.assistant pre .pre-actions .copy-btn { padding: 4px 10px; font-size: 10px; min-height: 22px; }

/* Always-visible copy icon on chat messages */
.chat-msg .msg-copy-btn { opacity: 0.55; }
.chat-msg:hover .msg-copy-btn,
.chat-msg:focus-within .msg-copy-btn { opacity: 1; }
.chat-msg .msg-copy-btn:active { opacity: 1; transform: scale(0.94); }

.chat-header-actions { display: flex; gap: 4px; margin-left: auto; align-items: center; }
.chat-header-actions .btn.icon-only { min-width: 34px; min-height: 34px; padding: 6px; }

.chat-search-bar {
  display: none; align-items: center; gap: 6px;
  padding: 8px 14px; background: var(--bg-1);
  border-bottom: 1px solid var(--border); flex-shrink: 0;
}
.chat-search-bar.active { display: flex; }
.chat-search-bar input {
  flex: 1; background: var(--bg-2); border: 1px solid var(--border);
  color: var(--fg-1); padding: 6px 10px; border-radius: 6px;
  font-size: 12px; outline: none; min-height: 32px;
}
.chat-search-bar input:focus { border-color: var(--blue); }
.chat-search-bar .result-count {
  font-size: 11px; color: var(--fg-3); font-family: monospace; white-space: nowrap;
}
.chat-search-bar .tsb-btn {
  background: transparent; border: 1px solid transparent; color: var(--fg-3);
  padding: 4px 8px; border-radius: 4px; cursor: pointer; min-height: 28px;
}
.chat-search-bar .tsb-btn:hover { background: var(--bg-3); color: var(--blue); }
.chat-msg.search-match { outline: 2px solid var(--yellow); outline-offset: 2px; }
.chat-msg.search-current { outline: 2px solid var(--orange); outline-offset: 2px; }

/* Log panel */
.log-entry {
  padding: 12px 14px; background: var(--bg-1);
  border: 1px solid var(--border); border-radius: var(--radius-sm);
  margin-bottom: 10px; border-left: 3px solid var(--blue);
}
.log-entry.breaking { border-left-color: var(--red); }
.log-entry.feature  { border-left-color: var(--green); }
.log-entry.fix      { border-left-color: var(--yellow); }
.log-entry .log-head { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; flex-wrap: wrap; }
.log-entry .log-version { font-family: monospace; font-weight: 700; font-size: 12px; color: var(--blue); }
.log-entry .log-date { font-size: 10px; color: var(--fg-4); font-family: monospace; }
.log-entry .log-badge {
  font-size: 9px; padding: 2px 6px; border-radius: 8px;
  font-weight: 600; text-transform: uppercase; letter-spacing: .5px;
}
.log-entry .log-badge.feature  { background: #23863622; color: var(--green); border: 1px solid #23863655; }
.log-entry .log-badge.fix      { background: #9e6a0322; color: var(--yellow); border: 1px solid #9e6a0355; }
.log-entry .log-badge.breaking { background: #da363322; color: var(--red);    border: 1px solid #da363355; }
.log-entry ul { padding-left: 18px; margin: 6px 0 0 0; font-size: 12px; line-height: 1.6; color: var(--fg-2); }
.log-entry li { margin-bottom: 4px; }
.log-entry li code { background: var(--bg-2); padding: 1px 5px; border-radius: 3px; font-family: monospace; font-size: 11px; color: var(--orange); }

.activity-item {
  display: flex; align-items: flex-start; gap: 8px;
  padding: 8px 10px; background: var(--bg-1);
  border: 1px solid var(--border-2); border-radius: 6px;
  margin-bottom: 4px; font-size: 11px;
}
.activity-item .act-time { font-family: monospace; color: var(--fg-4); font-size: 10px; white-space: nowrap; flex-shrink: 0; min-width: 42px; }
.activity-item .act-icon { flex-shrink: 0; width: 14px; text-align: center; }
.activity-item .act-body { flex: 1; color: var(--fg-2); word-break: break-word; }
.activity-item.kind-file  .act-icon { color: var(--blue); }
.activity-item.kind-tool  .act-icon { color: var(--green); }
.activity-item.kind-error .act-icon { color: var(--red); }
.activity-item.kind-save  .act-icon { color: var(--green); }
.activity-item.kind-git   .act-icon { color: var(--yellow); }
</style>
</head>
<body>

<!-- ═══════════ HEADER ═══════════ -->
<div class="header">
  <div class="header-left">
    <button class="btn icon-only menu-btn" id="menuLeftBtn" style="display:none" title="Files">
      <i class="fas fa-bars"></i>
    </button>
    <div class="logo">
      <i class="fas fa-brain"></i><b>DeepSeek</b><span class="hide-mobile">&nbsp;Studio</span>
    </div>
  </div>
  <div class="header-right">
    <div class="status" title="Backend status">
      <span class="dot checking" id="statusDot"></span>
      <span id="statusText" class="label">...</span>
    </div>
    <span id="langBadge" class="lang-badge" style="display:none"></span>
    <button class="btn primary icon-only" id="saveBtn" title="Save (Ctrl+S)">
      <i class="fas fa-save"></i>
    </button>
    <button class="btn icon-only" id="compileBtn" title="Compile current file" style="color:var(--green)">
      <i class="fas fa-bolt"></i>
    </button>
    <button class="btn icon-only menu-btn" id="menuRightBtn" style="display:none" title="Panels">
      <i class="fas fa-sliders-h"></i>
    </button>
  </div>
</div>

<div class="offline-banner" id="offlineBanner">
  <i class="fas fa-wifi"></i> You're offline — backend not reachable
</div>

<div class="backdrop" id="backdrop"></div>

<!-- ═══════════ MAIN ═══════════ -->
<div class="main">

  <div class="file-tree" id="fileTree">
    <div class="ft-head">
      <span>Projects</span>
      <div style="display:flex;gap:4px">
        <button class="btn icon-only" id="linkFolderBtn" title="Link external folder" style="min-width:32px;min-height:32px;padding:6px">
          <i class="fas fa-link"></i>
        </button>
        <button class="btn icon-only" id="refreshTreeBtn" title="Refresh" style="min-width:32px;min-height:32px;padding:6px">
          <i class="fas fa-sync"></i>
        </button>
        <button class="btn icon-only" id="newFileBtn" title="New file" style="min-width:32px;min-height:32px;padding:6px">
          <i class="fas fa-plus"></i>
        </button>
      </div>
    </div>
    <div class="ft-body" id="ftBody"></div>
  </div>

  <div class="content-area">

    <div class="primary-tabs">
      <div class="ptab active" data-panel="chat"><i class="fas fa-comments"></i> Chat</div>
      <div class="ptab" data-panel="editor"><i class="fas fa-code"></i> Editor <span class="tab-badge" id="editorBadge"></span></div>
      <div class="ptab" data-panel="terminal"><i class="fas fa-terminal"></i> Terminal <span class="tab-badge" id="terminalBadge"></span></div>
    </div>

    <!-- CHAT PANEL -->
    <div class="tab-panel active" id="panel-chat">
      <div class="chat-header">
        <label><i class="fas fa-folder-open"></i> Working in:</label>
        <select id="workspaceSelector">
          <option value="">-- select a project --</option>
        </select>
        <span class="context-badge" id="contextBadge" style="display:none"><b>~</b> <span id="contextInfo"></span></span>
        <span class="warn-badge" id="chatWarnBadge"></span>
        <div class="chat-header-actions">
          <button class="btn icon-only" id="chatSearchBtn" title="Search chat (Ctrl+Shift+F)">
            <i class="fas fa-search"></i>
          </button>
          <button class="btn icon-only" id="chatCopyAllBtn" title="Copy entire chat as markdown">
            <i class="fas fa-copy"></i>
          </button>
          <button class="btn icon-only" id="chatExportBtn" title="Export chat as JSON">
            <i class="fas fa-download"></i>
          </button>
        </div>
      </div>
      <div class="chat-search-bar" id="chatSearchBar">
        <input type="text" id="chatSearchInput" placeholder="Search messages…" autocomplete="off" spellcheck="false" />
        <span class="result-count" id="chatSearchCount">0/0</span>
        <button class="tsb-btn" id="chatSearchPrev" title="Previous (Shift+Enter)"><i class="fas fa-chevron-up"></i></button>
        <button class="tsb-btn" id="chatSearchNext" title="Next (Enter)"><i class="fas fa-chevron-down"></i></button>
        <button class="tsb-btn" id="chatSearchClose" title="Close (Esc)"><i class="fas fa-times"></i></button>
      </div>
      <div class="chat-messages" id="chatMessages">
        <div class="chat-msg assistant">
          <p>👋 Welcome to <b>DeepSeek Studio</b>.</p>
          <p>Pick a project above, then tell me what to build. I can create files, run commands, and deploy.</p>
          <p style="margin-top:12px">
            <button class="welcome-cta" onclick="openDrawer('right'); document.querySelector('[data-tab=settings]').click();">
              <span class="welcome-cta-icon">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>
                </svg>
              </span>
              <span>Set up your DeepSeek API key</span>
              <svg class="welcome-cta-arrow" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </button>
          </p>
          <p style="font-size:12px;color:var(--fg-3);margin-top:8px">Free to install. You only pay DeepSeek for what you use.</p>
          <p style="font-size:12px;color:var(--fg-3);margin-top:6px">💡 Tip: click the <b>🔗</b> button in the file tree header to link any folder from your phone storage.</p>
        </div>
      </div>
      <div class="ai-input-bar">
        <div class="snippet-dropdown" id="snippetDropdown"></div>
        <label class="ai-toggle" id="autoRunLabel" title="Auto-run tool calls without confirmation">
          <input type="checkbox" id="autoRunToggle" style="width:auto" />
          <span>Auto</span>
        </label>
        <span class="ctx-indicator" id="ctxIndicator" title="Current file context">📄 No file</span>
        <textarea id="aiInput" placeholder="Tell the AI what to do… (type / for snippets)" rows="1"></textarea>
        <button type="submit" id="aiSendBtn" title="Send"><i class="fas fa-paper-plane"></i></button>
      </div>
    </div>

    <!-- EDITOR PANEL -->
    <div class="tab-panel" id="panel-editor">
      <div class="editor-tabs-bar" id="editorTabsBar" style="display:none"></div>
      <div id="monaco">
        <div class="editor-empty" id="editorEmpty">
          <i class="fas fa-file-code"></i>
          <div class="title">No file open</div>
          <div class="hint">Tap a file in the tree to open it here</div>
          <div class="hint" style="margin-top:8px">or type <code> / </code> in chat for AI snippets</div>
          <div class="hint" style="margin-top:16px;font-size:11px;line-height:1.8">
            <b>Shortcuts:</b><br>
            <code>Ctrl+S</code> Save · <code>Ctrl+Shift+S</code> Save As<br>
            <code>Ctrl+W</code> Close tab · <code>Ctrl+F</code> Find in terminal<br>
            <code>Ctrl+K</code> Clear terminal · <code>F5</code> Refresh status<br>
            <code>Ctrl+Shift+F</code> Search chat
          </div>
        </div>
      </div>
    </div>

    <!-- TERMINAL PANEL -->
    <div class="tab-panel" id="panel-terminal">
      <div id="terminal-container">
        <div class="terminal-toolbar">
          <button class="tbtn" id="termClearBtn" title="Clear screen"><i class="fas fa-eraser"></i> Clear</button>
          <button class="tbtn" id="termCopyBtn" title="Copy all"><i class="fas fa-copy"></i></button>
          <button class="tbtn" id="termPasteBtn" title="Paste"><i class="fas fa-paste"></i></button>
          <div class="sep"></div>
          <button class="tbtn" id="termSearchBtn" title="Find (Ctrl+F)"><i class="fas fa-search"></i></button>
          <div class="term-search-bar" id="termSearchBar">
            <input id="termSearchInput" type="text" placeholder="Find…" autocomplete="off" spellcheck="false" />
            <button class="tsb-btn" id="termSearchPrev" title="Previous (Shift+Enter)"><i class="fas fa-chevron-up"></i></button>
            <button class="tsb-btn" id="termSearchNext" title="Next (Enter)"><i class="fas fa-chevron-down"></i></button>
            <label class="tsb-opt" title="Case sensitive">
              <input type="checkbox" id="termSearchCase" /> Aa
            </label>
            <label class="tsb-opt" title="Regex">
              <input type="checkbox" id="termSearchRegex" /> .*
            </label>
            <button class="tsb-btn" id="termSearchClose" title="Close (Esc)"><i class="fas fa-times"></i></button>
          </div>
          <div class="sep"></div>
          <button class="tbtn" id="termCtrlCBtn" title="Send Ctrl+C"><i class="fas fa-stop-circle"></i></button>
          <button class="tbtn" id="termCtrlDBtn" title="Send Ctrl+D"><i class="fas fa-sign-out-alt"></i></button>
          <div class="sep"></div>
          <button class="tbtn" id="termTopBtn" title="Top"><i class="fas fa-arrow-up"></i></button>
          <button class="tbtn" id="termBottomBtn" title="Bottom"><i class="fas fa-arrow-down"></i></button>
          <div class="sep"></div>
          <button class="tbtn danger" id="termKillBtn" title="Kill current process"><i class="fas fa-skull"></i></button>
          <span class="term-info" id="termInfo">
            <span class="pulse" id="termPulse"></span>
            <span id="termInfoText">Ready</span>
          </span>
        </div>
        <div id="terminal"></div>
      </div>
    </div>

  </div>

  <!-- SIDEBAR -->
  <div class="sidebar" id="sidebar">
    <div class="side-tabs">
      <div class="stab active" data-tab="ai"><i class="fas fa-robot"></i><span>AI</span></div>
      <div class="stab" data-tab="templates"><i class="fas fa-cubes"></i><span>Tpl</span></div>
      <div class="stab" data-tab="generate"><i class="fas fa-magic"></i><span>Gen</span></div>
      <div class="stab" data-tab="term"><i class="fas fa-terminal"></i><span>Term</span></div>
      <div class="stab" data-tab="github"><i class="fab fa-github"></i><span>Git</span></div>
      <div class="stab" data-tab="deploy"><i class="fas fa-rocket"></i><span>Build</span></div>
      <div class="stab" data-tab="backup"><i class="fas fa-hdd"></i><span>Backup</span></div>
      <div class="stab" data-tab="log"><i class="fas fa-history"></i><span>Log</span></div>
      <div class="stab" data-tab="settings"><i class="fas fa-cog"></i><span>Setup</span></div>
    </div>
    <div class="side-content">

      <!-- AI PANEL -->
      <div class="panel active" id="panel-ai">
        <div class="auto-toggle">
          <input type="checkbox" id="autoRunToggle2" />
          <label for="autoRunToggle2">Auto-run tool calls</label>
          <span class="hint" id="autoRunHint">(off = confirm)</span>
        </div>
        <div class="auto-toggle">
          <input type="checkbox" id="streamToggle" checked />
          <label for="streamToggle">Stream responses</label>
          <span class="hint">(beta)</span>
        </div>

        <div class="settings-section">
          <h3><i class="fas fa-file-code"></i> Editor Actions</h3>
          <button class="btn action-btn" id="actSaveAs"><i class="fas fa-copy"></i> Save As…</button>
          <button class="btn action-btn" id="actReload"><i class="fas fa-sync"></i> Reload from disk</button>
          <button class="btn action-btn" id="actClose"><i class="fas fa-times"></i> Close current tab</button>
          <button class="btn action-btn" id="actFind"><i class="fas fa-search"></i> Find</button>
          <button class="btn action-btn" id="actReplace"><i class="fas fa-exchange-alt"></i> Find &amp; Replace</button>
          <button class="btn action-btn" id="actFormat"><i class="fas fa-align-left"></i> Format document</button>
          <button class="btn action-btn" id="actWordWrap"><i class="fas fa-text-width"></i> Toggle word wrap</button>
          <button class="btn action-btn" id="actMinimap"><i class="fas fa-map"></i> Toggle minimap</button>
        </div>

        <div class="settings-section">
          <h3><i class="fas fa-bolt"></i> Quick Prompts</h3>
          <button class="btn action-btn" onclick="quickPrompt('Explain the code in the currently open file')">📖 Explain current file</button>
          <button class="btn action-btn" onclick="quickPrompt('Find and fix bugs in the currently open file')">🐛 Find bugs</button>
          <button class="btn action-btn" onclick="quickPrompt('Add comments and documentation to the currently open file')">📝 Add docs</button>
          <button class="btn action-btn" onclick="quickPrompt('Write unit tests for the currently open file')">🧪 Write tests</button>
          <button class="btn action-btn" onclick="quickPrompt('Optimize and refactor the currently open file for performance')">⚡ Optimize</button>
          <button class="btn action-btn" onclick="quickPrompt('Review my project structure and suggest improvements')">🔍 Review project</button>
          <button class="btn action-btn" onclick="quickPrompt('Add error handling and logging to the currently open file')">🛡️ Add error handling</button>
          <button class="btn action-btn" onclick="quickPrompt('Convert the currently open file to use best practices for its language')">✨ Modernize code</button>
        </div>

        <div class="settings-section">
          <h3><i class="fas fa-history"></i> Chat History</h3>
          <button class="btn action-btn" id="clearChatBtn"><i class="fas fa-trash"></i> Clear chat history</button>
          <button class="btn action-btn" id="exportChatBtn"><i class="fas fa-download"></i> Export chat as JSON</button>
        </div>

        <button class="btn primary" id="goToChatBtn" style="width:100%;justify-content:center;padding:12px">
          <i class="fas fa-comments"></i> Open Chat
        </button>
      </div>

      <!-- TEMPLATES -->
      <div class="panel" id="panel-templates">
        <h3 style="font-size:14px;margin-bottom:12px;color:var(--fg-0)">Project Templates</h3>
        <p style="font-size:12px;color:var(--fg-3);margin-bottom:14px">Tap to scaffold a starter project.</p>
        <div id="templatesList"></div>
      </div>

      <!-- GENERATE -->
      <div class="panel" id="panel-generate">
        <h3 style="font-size:14px;margin-bottom:12px;color:var(--fg-0)">AI Project Generator</h3>
        <p style="font-size:12px;color:var(--fg-3);margin-bottom:14px">Describe your app — AI will scaffold it.</p>
        <textarea id="genPrompt" placeholder="A Flutter counter app with dark theme…" style="min-height:110px;margin-bottom:10px"></textarea>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:10px">
          <select id="genLanguage">
            <option value="flutter">Flutter</option>
            <option value="kotlin">Kotlin JVM</option>
            <option value="android">Android</option>
            <option value="python">Python</option>
            <option value="node">Node.js</option>
            <option value="react">React</option>
            <option value="html">HTML</option>
            <option value="rust">Rust</option>
            <option value="go">Go</option>
          </select>
          <input id="genProjectName" placeholder="project-name" />
        </div>
        <button class="btn primary" id="genBtn" style="width:100%;justify-content:center;padding:12px">
          <i class="fas fa-magic"></i> Generate Project
        </button>
        <div class="progress-bar" id="genProgressBar" style="display:none"><div class="fill" style="width:0%"></div></div>
        <div id="genProgress" style="margin-top:12px;font-size:12px;color:var(--fg-3);line-height:1.6"></div>
      </div>

      <!-- TERMINAL SIDEBAR -->
      <div class="panel" id="panel-term">
        <h3 style="font-size:14px;margin-bottom:12px;color:var(--fg-0)">
          <i class="fas fa-bolt"></i> Quick Commands
        </h3>
        <div id="quickCommandsList"></div>

        <div class="settings-section" style="margin-top:20px">
          <h3><i class="fas fa-box"></i> Package Managers</h3>
          <div class="pkg-grid">
            <button class="pkg-btn" data-cmd="pkg update && pkg upgrade -y"><i class="fas fa-cube"></i> pkg update</button>
            <button class="pkg-btn" data-cmd="pkg list-installed | head -50"><i class="fas fa-list"></i> List pkgs</button>
            <button class="pkg-btn" data-cmd="pip list"><i class="fab fa-python"></i> pip list</button>
            <button class="pkg-btn" data-cmd="npm list -g --depth=0"><i class="fab fa-node-js"></i> npm global</button>
          </div>
          <input type="text" id="pkgSearchInput" placeholder="Package name…" style="margin-bottom:8px" />
          <button class="btn" id="pkgInstallBtn" style="width:100%;justify-content:center;padding:10px;margin-bottom:10px">
            <i class="fas fa-download"></i> Install Package
          </button>
        </div>

        <div class="settings-section">
          <h3><i class="fas fa-key"></i> Environment Variables</h3>
          <div id="envVarsList"></div>
          <div class="env-row">
            <input type="text" id="envKey" placeholder="KEY" />
            <input type="text" id="envVal" placeholder="value" />
            <button class="btn" id="envAddBtn" title="Add">+</button>
          </div>
        </div>

        <div class="settings-section">
          <h3><i class="fas fa-history"></i> Command History</h3>
          <div id="cmdHistoryList" style="max-height:220px;overflow-y:auto;background:var(--bg-1);border:1px solid var(--border);border-radius:var(--radius-sm);padding:6px"></div>
          <button class="btn" id="clearHistoryBtn" style="width:100%;justify-content:center;padding:10px;margin-top:8px">
            <i class="fas fa-trash"></i> Clear history
          </button>
        </div>

        <div class="settings-section">
          <h3><i class="fas fa-server"></i> Running Processes</h3>
          <button class="btn" id="refreshProcessesBtn" style="width:100%;justify-content:center;padding:10px;margin-bottom:10px">
            <i class="fas fa-sync"></i> Refresh
          </button>
          <div id="processesList" style="font-size:11px;max-height:220px;overflow-y:auto"></div>
        </div>
      </div>

      <!-- GITHUB PANEL -->
      <div class="panel" id="panel-github">
        <div class="settings-section">
          <h3><i class="fab fa-github"></i> Git Identity</h3>
          <input type="text" id="ghName" placeholder="Your Name" style="margin-bottom:8px" />
          <input type="email" id="ghEmail" placeholder="you@example.com" style="margin-bottom:10px" />
          <button class="btn primary" id="ghSaveIdentity" style="width:100%;justify-content:center;padding:10px">Save Identity</button>
        </div>
        <div class="settings-section">
          <h3><i class="fas fa-key"></i> GitHub Token</h3>
          <input type="password" id="ghToken" placeholder="ghp_..." style="margin-bottom:10px" />
          <button class="btn" id="ghSaveToken" style="width:100%;justify-content:center;padding:10px">Save Token</button>
          <p style="font-size:11px;color:var(--fg-3);margin-top:8px;line-height:1.5">
            <i class="fas fa-lock" style="color:var(--green)"></i>
            Token stored server-side in <code>~/.deepseek-secrets.json</code> (mode 0600). Never appears in git config or process args.
          </p>
        </div>
        <div class="settings-section">
          <h3><i class="fas fa-code-branch"></i> Repository</h3>
          <p id="ghRepoInfo" style="font-size:11px;color:var(--fg-3);font-family:monospace;word-break:break-all">Not connected</p>
          <p id="ghBranchInfo" style="font-size:11px;color:var(--fg-3);font-family:monospace">Branch: -</p>
        </div>
        <div class="settings-section">
          <h3><i class="fas fa-cloud-download-alt"></i> Clone</h3>
          <input type="text" id="ghCloneUrl" placeholder="https://github.com/user/repo.git" style="margin-bottom:10px" />
          <button class="btn primary" id="ghCloneBtn" style="width:100%;justify-content:center;padding:10px">Clone Repository</button>
        </div>
        <div class="settings-section">
          <h3><i class="fas fa-code-branch"></i> Branches</h3>
          <div id="ghBranchList" style="font-size:11px;margin-bottom:10px">—</div>
          <input type="text" id="ghNewBranchName" placeholder="new-branch-name" style="margin-bottom:8px" />
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:8px">
            <button class="btn" id="ghCreateBranchBtn" style="justify-content:center;padding:10px">+ Create</button>
            <button class="btn" id="ghCheckoutBranchBtn" style="justify-content:center;padding:10px">Checkout</button>
          </div>
          <input type="text" id="ghMergeSource" placeholder="branch to merge" style="margin-bottom:8px" />
          <button class="btn primary" id="ghMergeBtn" style="width:100%;justify-content:center;padding:10px">Merge</button>
          <button class="btn" id="ghAbortMergeBtn" style="width:100%;justify-content:center;padding:10px;margin-top:8px;display:none">Abort Merge</button>
        </div>
        <div class="settings-section">
          <h3><i class="fas fa-edit"></i> Changes</h3>
          <div id="ghChangesList" class="git-changes-list">No changes</div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
            <button class="btn" id="ghAddAllBtn" style="justify-content:center;padding:10px">Stage All</button>
            <button class="btn" id="ghResetAllBtn" style="justify-content:center;padding:10px">Unstage All</button>
          </div>
        </div>
        <div class="settings-section">
          <h3><i class="fas fa-upload"></i> Commit &amp; Push</h3>
          <input type="text" id="ghCommitMsg" placeholder="Commit message" style="margin-bottom:8px" />
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:8px">
            <button class="btn" id="ghCommitOnlyBtn" style="justify-content:center;padding:10px">Commit</button>
            <button class="btn primary" id="ghPushBtn" style="justify-content:center;padding:10px">Commit + Push</button>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
            <button class="btn" id="ghPullBtn" style="justify-content:center;padding:10px">Pull</button>
            <button class="btn" id="ghPullRebaseBtn" style="justify-content:center;padding:10px">Pull --rebase</button>
          </div>
          <button class="btn" id="ghFetchBtn" style="width:100%;justify-content:center;padding:10px;margin-top:8px">
            <i class="fas fa-sync"></i> Fetch
          </button>
        </div>
        <div class="settings-section">
          <h3><i class="fas fa-box"></i> Stash</h3>
          <input type="text" id="ghStashMsg" placeholder="Stash message (optional)" style="margin-bottom:8px" />
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:8px">
            <button class="btn" id="ghStashPushBtn" style="justify-content:center;padding:10px">Stash</button>
            <button class="btn" id="ghStashPopBtn" style="justify-content:center;padding:10px">Pop</button>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
            <button class="btn" id="ghStashListBtn" style="justify-content:center;padding:10px">List</button>
            <button class="btn danger" id="ghStashClearBtn" style="justify-content:center;padding:10px">Clear All</button>
          </div>
        </div>
        <div class="settings-section">
          <h3><i class="fas fa-history"></i> History</h3>
          <div id="ghLogList" style="font-size:11px;max-height:280px;overflow-y:auto">—</div>
          <button class="btn" id="ghLogBtn" style="width:100%;justify-content:center;padding:10px;margin-top:8px">
            <i class="fas fa-sync"></i> Refresh Log
          </button>
        </div>
        <div class="settings-section">
          <h3><i class="fas fa-tag"></i> Tags</h3>
          <div id="ghTagList" style="font-size:11px;margin-bottom:10px">—</div>
          <input type="text" id="ghTagName" placeholder="v1.0.0" style="margin-bottom:8px" />
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
            <button class="btn" id="ghTagCreateBtn" style="justify-content:center;padding:10px">Create Tag</button>
            <button class="btn" id="ghTagPushBtn" style="justify-content:center;padding:10px">Push Tags</button>
          </div>
        </div>
        <div class="settings-section">
          <h3><i class="fas fa-undo"></i> Recovery</h3>
          <button class="btn warn" id="ghUndoBtn" style="width:100%;justify-content:center;padding:10px">
            <i class="fas fa-undo"></i> Revert Last Commit
          </button>
          <button class="btn danger" id="ghHardResetBtn" style="width:100%;justify-content:center;padding:10px;margin-top:8px">
            <i class="fas fa-exclamation-triangle"></i> Hard Reset
          </button>
        </div>
        <div class="settings-section">
          <h3><i class="fas fa-terminal"></i> Output</h3>
          <pre id="ghOutput" style="background:var(--bg-0);border:1px solid var(--border-2);border-radius:var(--radius-sm);padding:12px;font-size:10px;max-height:280px;overflow:auto;color:var(--fg-2);white-space:pre-wrap;display:none"></pre>
        </div>
      </div>

      <!-- DEPLOY PANEL -->
      <div class="panel" id="panel-deploy">
        <div class="settings-section">
          <h3><i class="fas fa-rocket"></i> Build Android App</h3>
          <p>Signed Android App Bundle (.aab) for Google Play.</p>
        </div>
        <div class="settings-section">
          <h3><i class="fas fa-tools"></i> 1. Toolchain Check</h3>
          <div id="toolchainStatus" style="font-size:12px;color:var(--fg-3);line-height:1.8">Checking…</div>
          <button class="btn primary" id="installToolsBtn" style="width:100%;justify-content:center;padding:10px;margin-top:10px;display:none">
            <i class="fas fa-download"></i> Install Missing Tools
          </button>
          <button class="btn" id="checkToolsBtn" style="width:100%;justify-content:center;padding:10px;margin-top:8px">
            <i class="fas fa-sync"></i> Re-check
          </button>
        </div>
        <div class="settings-section">
          <h3><i class="fas fa-key"></i> 2. Signing Key</h3>
          <p style="font-size:11px;line-height:1.6">Keystore signs your release. Keep it safe — never share.</p>
          <input type="text" id="ksProjectName" placeholder="Project name" style="margin-bottom:8px" />
          <input type="password" id="ksPassword" placeholder="Keystore password" style="margin-bottom:8px" />
          <input type="text" id="ksAlias" placeholder="Key alias (optional)" style="margin-bottom:10px" />
          <button class="btn primary" id="createKeystoreBtn" style="width:100%;justify-content:center;padding:10px">
            <i class="fas fa-plus"></i> Create Keystore
          </button>
          <div id="keystoreList" style="margin-top:12px;font-size:11px"></div>
        </div>
        <div class="settings-section">
          <h3><i class="fas fa-cube"></i> 3. Build Bundle</h3>
          <select id="deployProject" class="modal-input" style="margin-bottom:8px"></select>
          <select id="deployOutput" class="modal-input" style="margin-bottom:8px">
            <option value="aab">AAB — Google Play Store</option>
            <option value="apk">APK — Direct install / testing</option>
          </select>
          <select id="deployKeystore" class="modal-input" style="margin-bottom:8px">
            <option value="">-- no signing (debug) --</option>
          </select>
          <input type="password" id="deployPassword" placeholder="Keystore password" style="margin-bottom:10px" />
          <button class="btn primary" id="buildDeployBtn" style="width:100%;justify-content:center;padding:12px;font-size:14px">
            <i class="fas fa-hammer"></i> Build
          </button>
          <pre id="buildOutput" style="margin-top:12px;background:var(--bg-0);border:1px solid var(--border-2);border-radius:var(--radius-sm);padding:12px;font-size:10px;max-height:220px;overflow:auto;color:var(--fg-2);white-space:pre-wrap;display:none"></pre>
        </div>
        <div class="settings-section">
          <h3><i class="fas fa-archive"></i> 4. Recent Artifacts</h3>
          <div id="artifactList" style="font-size:11px"></div>
          <button class="btn" id="refreshArtifactsBtn" style="width:100%;justify-content:center;padding:10px;margin-top:8px">
            <i class="fas fa-sync"></i> Refresh
          </button>
        </div>
      </div>

      <!-- BACKUP PANEL -->
      <div class="panel" id="panel-backup">
        <div class="settings-section">
          <h3><i class="fas fa-hdd"></i> SD Card Backup</h3>
          <p>Snapshot your workspace. Keeps last 5 backups.</p>
          <p style="color:var(--blue);font-size:11px;font-family:monospace;word-break:break-all" id="backupDest">~/storage/external-1/DeepSeekBackups/</p>
          <p id="backupStatus" style="color:var(--fg-3);font-size:11px"></p>
        </div>
        <button class="btn primary" id="backupNowBtn" style="width:100%;justify-content:center;padding:14px;font-size:14px;margin-bottom:12px">
          <i class="fas fa-save"></i> Back Up Now
        </button>
        <div class="settings-section">
          <h3 style="margin-bottom:10px">Recent Backups</h3>
          <div id="backupList"></div>
        </div>
      </div>

      <!-- LOG PANEL: Updates & Activity + Git Records -->
      <div class="panel" id="panel-log">
        <h3 style="font-size:14px;margin-bottom:12px;color:var(--fg-0)">
          <i class="fas fa-history"></i> Updates &amp; Activity
        </h3>

        <!-- Git & GitHub Records -->
        <div class="settings-section">
          <h3><i class="fab fa-github"></i> Git &amp; GitHub Records</h3>
          <div id="gitRecordsList" style="max-height:280px;overflow-y:auto"></div>
          <button class="btn" id="clearGitRecordsBtn" style="width:100%;justify-content:center;padding:8px;margin-top:8px;font-size:11px">
            <i class="fas fa-trash"></i> Clear records
          </button>
        </div>

        <div class="settings-section">
          <h3><i class="fas fa-tag"></i> Current Version</h3>
          <p id="logCurrentVersion" style="font-family:monospace;color:var(--blue);font-size:12px">loading…</p>
        </div>

        <div class="settings-section">
          <h3><i class="fas fa-satellite-dish"></i> Recent Activity</h3>
          <div id="activityList" style="max-height:220px;overflow-y:auto"></div>
          <button class="btn" id="clearActivityBtn" style="width:100%;justify-content:center;padding:8px;margin-top:8px;font-size:11px">
            <i class="fas fa-trash"></i> Clear activity
          </button>
        </div>

        <div class="settings-section">
          <h3><i class="fas fa-stream"></i> Changelog</h3>
          <div id="changelogList"></div>
        </div>
      </div>

      <!-- SETTINGS PANEL -->
      <div class="panel" id="panel-settings">
        <div class="settings-section">
          <h3>AI Provider</h3>
          <select id="aiProvider">
            <option value="deepseek">DeepSeek (paid, cheapest)</option>
            <option value="gemini">Google Gemini (free tier)</option>
          </select>
        </div>
        <div class="settings-section" id="deepseekKeySection">
          <h3><i class="fas fa-key" style="color:var(--yellow)"></i> DeepSeek API Key</h3>

          <div class="ds-hero">
            <div class="ds-hero-icon">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>
              </svg>
            </div>
            <div class="ds-hero-body">
              <div class="ds-hero-title">Bring your own DeepSeek key</div>
              <div class="ds-hero-sub">Pay-as-you-go · ~$0.14 per million tokens · No subscription</div>
            </div>
          </div>

          <div class="ds-steps">
            <a class="ds-step" href="https://platform.deepseek.com/sign_up" target="_blank" rel="noopener">
              <span class="ds-step-num">1</span>
              <span class="ds-step-body">
                <span class="ds-step-title">Create account</span>
                <span class="ds-step-sub">Free sign-up · email only</span>
              </span>
              <svg class="ds-step-arrow" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M7 7h10v10"/></svg>
            </a>
            <a class="ds-step" href="https://platform.deepseek.com/top_up" target="_blank" rel="noopener">
              <span class="ds-step-num">2</span>
              <span class="ds-step-body">
                <span class="ds-step-title">Add credits</span>
                <span class="ds-step-sub">$5 ≈ weeks of coding</span>
              </span>
              <svg class="ds-step-arrow" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M7 7h10v10"/></svg>
            </a>
            <a class="ds-step" href="https://platform.deepseek.com/api_keys" target="_blank" rel="noopener">
              <span class="ds-step-num">3</span>
              <span class="ds-step-body">
                <span class="ds-step-title">Create API key</span>
                <span class="ds-step-sub">Copy the sk-… key</span>
              </span>
              <svg class="ds-step-arrow" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M7 7h10v10"/></svg>
            </a>
          </div>

          <label class="ds-input-label">Paste your key</label>
          <div class="ds-input-wrap">
            <input type="password" id="apiKeyInput" placeholder="sk-..." autocomplete="off" autocapitalize="off" spellcheck="false" />
            <button type="button" class="ds-input-btn" id="apiKeyPasteBtn" title="Paste from clipboard">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
                <rect x="8" y="2" width="8" height="4" rx="1" ry="1"/>
              </svg>
            </button>
            <button type="button" class="ds-input-btn" id="apiKeyRevealBtn" title="Show/hide key">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
            </button>
          </div>

          <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px">
            <button class="btn primary" id="apiKeyWizardBtn" style="justify-content:center;padding:10px"><i class="fas fa-magic"></i> Step-by-step</button>
            <button class="btn" id="apiKeyTestBtn" style="justify-content:center;padding:10px"><i class="fas fa-vial"></i> Test key</button>
          </div>

          <p id="apiKeyStatus" style="font-size:11px;margin-top:10px;color:var(--fg-3)">Not verified</p>

          <p style="font-size:11px;color:var(--fg-3);margin-top:12px;line-height:1.5">
            <i class="fas fa-lock" style="color:var(--green)"></i>
            Your key is stored only in this browser's localStorage. It never leaves your device except to call the DeepSeek API directly from your phone.
          </p>

          <p style="font-size:11px;color:var(--fg-3);margin-top:8px">
            <a href="https://api-docs.deepseek.com/quick_start/pricing" target="_blank" rel="noopener" style="color:var(--blue)">
              <i class="fas fa-external-link-alt"></i> Current pricing &amp; models
            </a>
          </p>
        </div>
        <div class="settings-section" id="geminiKeySection" style="display:none">
          <h3>Google Gemini API Key</h3>
          <input type="password" id="geminiKeyInput" placeholder="AIza..." style="margin-bottom:8px" />
          <button class="btn primary" id="geminiKeyTestBtn" style="width:100%;justify-content:center;padding:10px">
            <i class="fas fa-vial"></i> Test &amp; Save
          </button>
          <p id="geminiKeyStatus" style="font-size:11px;margin-top:10px;color:var(--fg-3)">Not verified</p>
        </div>
        <div class="settings-section">
          <h3><i class="fas fa-crown" style="color:var(--yellow)"></i> Pro License</h3>
          <input type="text" id="licenseKeyInput" placeholder="DS-PRO-XXXX-XXXX-XXXX" style="margin-bottom:8px" />
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
            <button class="btn primary" id="licenseSaveBtn" style="justify-content:center;padding:10px"><i class="fas fa-check"></i> Activate</button>
            <button class="btn" id="licenseRemoveBtn" style="justify-content:center;padding:10px"><i class="fas fa-times"></i> Remove</button>
          </div>
          <p id="licenseStatus" style="font-size:11px;margin-top:10px;color:var(--fg-3)">Checking…</p>
        </div>
        <div class="settings-section">
          <h3><i class="fas fa-server"></i> Backend</h3>
          <p id="backendStatus" style="color:var(--red)">Checking…</p>
          <p id="backendVersion" style="color:var(--fg-3);font-size:11px;margin-top:4px"></p>
          <div id="libsStatus" class="libs-status"></div>
        </div>

        <div class="settings-section">
          <h3><i class="fas fa-link"></i> External Folders</h3>
          <p style="font-size:11px;color:var(--fg-3);line-height:1.5">
            Link folders from your phone storage into the workspace. Everything (editor, git, AI) treats them like normal subfolders. The original folder is never modified or moved.
          </p>
          <button class="btn primary" id="settingsLinkFolderBtn" style="width:100%;justify-content:center;padding:10px;margin-bottom:10px">
            <i class="fas fa-plus"></i> Link a Folder
          </button>
          <div id="linksList" style="font-size:11px"></div>
        </div>

        <div class="settings-section">
          <h3>Terminal</h3>
          <label style="display:flex;align-items:center;gap:10px;font-size:12px;color:var(--fg-2);margin-top:10px;min-height:36px">
            <input type="checkbox" id="termAutoScrollToggle" style="width:auto" checked />
            Auto-scroll to bottom
          </label>
          <label style="display:flex;align-items:center;gap:10px;font-size:12px;color:var(--fg-2);margin-top:10px;min-height:36px">
            <input type="checkbox" id="termWebglToggle" style="width:auto" checked />
            Use GPU renderer (WebGL)
          </label>
        </div>
        <div class="settings-section">
          <h3>Auto-Git</h3>
          <label style="display:flex;align-items:center;gap:10px;font-size:12px;color:var(--fg-2);margin-top:10px;min-height:36px">
            <input type="checkbox" id="autoGitToggle" style="width:auto" checked />
            Auto-commit on save
          </label>
        </div>
        <div class="settings-section">
          <h3>Editor</h3>
          <label style="display:flex;align-items:center;gap:10px;font-size:12px;color:var(--fg-2);margin-top:10px;min-height:36px">
            <input type="checkbox" id="editorWordWrapToggle" style="width:auto" checked />
            Word wrap
          </label>
          <label style="display:flex;align-items:center;gap:10px;font-size:12px;color:var(--fg-2);margin-top:10px;min-height:36px">
            <input type="checkbox" id="editorMinimapToggle" style="width:auto" />
            Show minimap
          </label>
          <div style="margin-top:12px">
            <label class="modal-label">Font size</label>
            <input type="number" id="editorFontSize" value="13" min="10" max="24" />
          </div>
        </div>
        <div class="settings-section">
          <h3>Install App</h3>
          <button class="btn" id="installPwaBtn" style="width:100%;justify-content:center;padding:10px;margin-top:10px;display:none">
            <i class="fas fa-download"></i> Install to Home Screen
          </button>
          <p id="pwaStatus" style="font-size:11px;color:var(--fg-3);margin-top:10px"></p>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- ═══════════ MODALS ═══════════ -->

<!-- New File Modal -->
<div class="modal-overlay" id="newFileModal">
  <div class="modal-box">
    <div class="modal-title">Create new file</div>
    <label class="modal-label" id="newFilePrefixLabel">Folder</label>
    <input type="text" class="modal-input" id="newFilePath" placeholder="e.g. src/utils/helper.py" autocomplete="off" autocapitalize="off" spellcheck="false" />
    <p style="font-size:11px;color:var(--fg-3);margin:-8px 0 12px">Nested paths auto-create folders.</p>
    <div class="modal-buttons">
      <button class="btn" id="modalCancel">Cancel</button>
      <button class="btn primary" id="modalCreate">Create</button>
    </div>
  </div>
</div>

<!-- Link External Folder Modal -->
<div class="modal-overlay" id="linkFolderModal">
  <div class="modal-box">
    <div class="modal-title">
      <i class="fas fa-link" style="color:var(--blue)"></i>
      Link an External Folder
    </div>
    <p style="font-size:12px;color:var(--fg-3);line-height:1.5;margin-bottom:12px">
      Browse to any folder on your phone. A link will be created inside the workspace — <b style="color:var(--fg-1)">the original folder is not modified</b>.
    </p>
    <div id="lfBreadcrumb" style="display:flex;flex-wrap:wrap;gap:4px;align-items:center;font-size:11px;font-family:monospace;background:var(--bg-1);border:1px solid var(--border);border-radius:var(--radius-sm);padding:8px 10px;margin-bottom:8px;min-height:36px">
      <span style="color:var(--fg-3)">/</span>
    </div>
    <div id="lfList" style="max-height:280px;overflow-y:auto;background:var(--bg-1);border:1px solid var(--border);border-radius:var(--radius-sm);padding:4px;margin-bottom:10px">
      <div style="padding:16px;text-align:center;color:var(--fg-3);font-size:12px">Loading…</div>
    </div>
    <label class="modal-label" style="margin-top:6px">Link name (optional)</label>
    <input type="text" class="modal-input" id="lfNameInput" placeholder="Defaults to the folder name" style="margin-bottom:12px" />
    <div style="display:flex;gap:8px">
      <button class="btn" id="lfCancelBtn" style="flex:1;justify-content:center;padding:10px">Cancel</button>
      <button class="btn primary" id="lfLinkBtn" style="flex:2;justify-content:center;padding:10px" disabled>
        <i class="fas fa-link"></i> Link this folder
      </button>
    </div>
    <p id="lfStatus" style="font-size:11px;color:var(--fg-3);margin-top:10px;line-height:1.5"></p>
  </div>
</div>

<!-- API Key Wizard -->
<div class="modal-overlay" id="apiKeyWizardModal">
  <div class="modal-box">
    <div class="modal-title">
      <i class="fas fa-key" style="color:var(--yellow)"></i>
      Get a DeepSeek API Key
    </div>
    <p style="font-size:12px;color:var(--fg-3);margin-bottom:16px;line-height:1.5">
      DeepSeek charges per token used — no subscription. <strong style="color:var(--fg-1)">$5 typically covers weeks of coding.</strong>
    </p>
    <div class="wizard-step" id="wizStep1">
      <div class="wizard-num">1</div>
      <div class="wizard-body">
        <div class="wizard-title">Create a DeepSeek account</div>
        <div class="wizard-desc">Free sign-up with email. Takes 30 seconds.</div>
        <button class="wizard-btn primary" onclick="openWizardLink('https://platform.deepseek.com/sign_up')">
          <i class="fas fa-external-link-alt"></i> Open sign-up page
        </button>
      </div>
    </div>
    <div class="wizard-step" id="wizStep2">
      <div class="wizard-num">2</div>
      <div class="wizard-body">
        <div class="wizard-title">Add credits ($5 recommended)</div>
        <div class="wizard-desc">Card or PayPal. $5 is ~35M tokens of deepseek-chat.</div>
        <button class="wizard-btn primary" onclick="openWizardLink('https://platform.deepseek.com/top_up')">
          <i class="fas fa-external-link-alt"></i> Open top-up page
        </button>
      </div>
    </div>
    <div class="wizard-step" id="wizStep3">
      <div class="wizard-num">3</div>
      <div class="wizard-body">
        <div class="wizard-title">Create your API key</div>
        <div class="wizard-desc">Click <em>Create new API key</em>, name it "DeepSeek Studio", then copy the <code>sk-…</code> value.</div>
        <button class="wizard-btn primary" onclick="openWizardLink('https://platform.deepseek.com/api_keys')">
          <i class="fas fa-external-link-alt"></i> Open API keys page
        </button>
      </div>
    </div>
    <div class="wizard-step" id="wizStep4">
      <div class="wizard-num">4</div>
      <div class="wizard-body">
        <div class="wizard-title">Paste your key here</div>
        <div class="wizard-desc">It will be verified against DeepSeek before saving.</div>
        <div class="ds-input-wrap" style="margin-top:8px">
          <input type="password" class="modal-input" id="wizKeyInput" placeholder="sk-..." autocomplete="off" autocapitalize="off" spellcheck="false" style="margin-bottom:0" />
          <button type="button" class="ds-input-btn" id="wizPasteBtn" title="Paste from clipboard">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
              <rect x="8" y="2" width="8" height="4" rx="1" ry="1"/>
            </svg>
          </button>
        </div>
        <button class="wizard-btn primary" style="width:100%;margin-top:8px;justify-content:center" onclick="verifyAndSaveWizardKey()">
          <i class="fas fa-check"></i> Verify &amp; Save
        </button>
        <div class="wizard-status" id="wizStatus"></div>
      </div>
    </div>
    <div class="modal-buttons" style="margin-top:14px">
      <button class="btn" onclick="closeApiKeyWizard()">Cancel</button>
      <button class="btn primary" onclick="closeApiKeyWizard()">Done</button>
    </div>
  </div>
</div>

<!-- Context Menu -->
<div class="ctx-menu" id="ctxMenu">
  <div class="ctx-title" id="ctxTitle">item</div>
  <div class="ctx-item" id="ctxOpen"><i class="fas fa-folder-open"></i> Open in Editor</div>
  <div class="ctx-item" id="ctxNewFileHere"><i class="fas fa-plus"></i> New file here…</div>
  <div class="ctx-item" id="ctxNewFolderHere"><i class="fas fa-folder-plus"></i> New folder here…</div>
  <div class="ctx-item" id="ctxReload"><i class="fas fa-sync"></i> Reload from disk</div>
  <div class="ctx-item" id="ctxBookmark"><i class="far fa-star"></i> Bookmark</div>
  <div class="ctx-item" id="ctxRename"><i class="fas fa-edit"></i> Rename</div>
  <div class="ctx-item" id="ctxCopyPath"><i class="fas fa-copy"></i> Copy path</div>
  <div class="ctx-item" id="ctxTerminalHere"><i class="fas fa-terminal"></i> Open terminal here</div>
  <div class="ctx-item" id="ctxUnlink" style="display:none"><i class="fas fa-unlink"></i> Unlink external folder</div>
  <div class="ctx-item danger" id="ctxDelete"><i class="fas fa-trash"></i> Delete</div>
</div>

<!-- Confirm -->
<div class="confirm-overlay" id="confirmModal">
  <div class="confirm-box">
    <div class="confirm-title" id="confirmTitle">Are you sure?</div>
    <div class="confirm-msg" id="confirmMsg">This cannot be undone.</div>
    <div class="confirm-buttons">
      <button class="btn" id="confirmCancel">Cancel</button>
      <button class="btn danger" id="confirmOk">Confirm</button>
    </div>
  </div>
</div>

<script>
console.log('[DS] boot v2.3.0');

/* ═══════════════════════════════════════════════════════════════════
   GLOBAL STATE
   ═══════════════════════════════════════════════════════════════════ */
var API = 'http://127.0.0.1:3001';
var editor = null;
var monacoLoaded = false;
var openFile = null;
var fileContent = '';
var fileModified = false;
var openTabs = [];
var activeTabPath = null;
var bookmarks = JSON.parse(localStorage.getItem('ds_bookmarks') || '[]');
var recentFiles = JSON.parse(localStorage.getItem('ds_recent') || '[]');
var chatHistory = JSON.parse(localStorage.getItem('ds_chat') || '[]');
var term = null;
var termAddons = { fit: null, search: null, serialize: null, webgl: null, webLinks: null };
var ws = null;
var isMobile = window.innerWidth <= 900;
var currentProject = localStorage.getItem('ds_current_project') || null;
var currentLang = { lang: 'unknown', build: null, run: null };
var ctxItem = null;
var confirmCallback = null;
var autoGitEnabled = localStorage.getItem('auto_git') !== 'false';
var autoRunEnabled = localStorage.getItem('auto_run') === 'true';
var streamEnabled = localStorage.getItem('stream_enabled') !== 'false';
var expandedFolders = {};
var treeCache = {};
var deferredInstallPrompt = null;
var activeTabPanel = 'chat';
var modifiedFiles = {};
var cmdHistory = JSON.parse(localStorage.getItem('ds_cmd_history') || '[]');
var envVars = JSON.parse(localStorage.getItem('ds_env_vars') || '{}');
var termAutoScroll = localStorage.getItem('term_auto_scroll') !== 'false';
var termWebgl = localStorage.getItem('term_webgl') !== 'false';
var editorWordWrap = localStorage.getItem('editor_word_wrap') !== 'false';
var editorMinimap = localStorage.getItem('editor_minimap') === 'true';
var editorFontSize = parseInt(localStorage.getItem('editor_font_size') || '13');
var isAITyping = false;
var aiTypingEl = null;
var newFilePrefix = '';

/* External link state for the picker modal */
var lfCurrentPath = '';
var lfCurrentParent = null;
var lfSelectedPath = '';
var lfAllowedRoots = [];
var linkIndex = {};

/* Activity log (persisted) */
var activityLog = JSON.parse(localStorage.getItem('ds_activity') || '[]');

/* NEW: Git/GitHub records — persistent audit log of every git action */
var gitRecords = JSON.parse(localStorage.getItem('ds_git_records') || '[]');

/* ═══════════════════════════════════════════════════════════════════
   CHANGELOG
   ═══════════════════════════════════════════════════════════════════ */
var CHANGELOG = [
  {
    version: '2.3.0', date: '2025-10', type: 'feature',
    items: [
      '⚡ <b>Compile button</b> — 15+ languages syntax check',
      '📦 <b>Recent artifacts</b> scanner (AAB/APK)',
      '🏷️ <b>Tags list</b> auto-populates in Git panel',
      '📱 <b>18 new Termux:API tools</b> — clipboard, battery, torch, vibrate, volume, TTS, dialog, wifi, location, share, camera, fingerprint, sms, call, contacts, sensor, brightness, IR',
      '🔧 <b>One-tap toolchain install</b> (openjdk-17, gradle)',
      '🔑 <b>Pro license</b> — activate/remove for signed AAB',
      '📜 <b>Git/GitHub records</b> — audit log of every action',
      '📋 <b>Always-visible copy icon</b> on every chat message'
    ]
  },
  {
    version: '2.2.0', date: '2025-10', type: 'feature',
    items: [
      '🔗 External folder linking — symlink any folder from your phone',
      '📁 Folder picker modal with breadcrumb navigation',
      '🛡️ Realpath-verified fs operations (no symlink escapes)',
      '📋 Copy buttons on every copyable surface',
      '🔍 In-chat search with match highlighting',
      '📜 Updates &amp; Activity log panel'
    ]
  },
  {
    version: '2.1.0', date: '2025-10', type: 'feature',
    items: [
      '🩺 Dynamic ESM import for <code>editkit</code>',
      '📊 Library status badges in Setup',
      '🎨 GPU renderer toggle for terminal (WebGL)',
      '🔎 Terminal search bar (Ctrl+F)'
    ]
  },
  {
    version: '2.0.0', date: '2025-10', type: 'feature',
    items: [
      '⚡ <b>simple-git</b> — fluent git operations',
      '🐙 <b>@octokit/rest</b> — typed GitHub API',
      '🖥️ <b>node-pty</b> — real TTY',
      '🧠 <b>editkit</b> — fuzzy SEARCH/REPLACE',
      '🎨 xterm.js 5.5 + WebGL/search/unicode11/serialize',
      '🔐 Server-side secret store'
    ]
  },
  {
    version: '1.0.0', date: '2025-09', type: 'feature',
    items: ['🎉 Initial release']
  }
];

/* ═══════════════════════════════════════════════════════════════════
   HELPERS
   ═══════════════════════════════════════════════════════════════════ */
function escapeHtml(s) {
  return String(s == null ? '' : s)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
}

function escAttr(s) {
  return String(s == null ? '' : s)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function logActivity(kind, message) {
  var entry = { ts: Date.now(), kind: kind, message: String(message).slice(0, 200) };
  activityLog.unshift(entry);
  activityLog = activityLog.slice(0, 100);
  try { localStorage.setItem('ds_activity', JSON.stringify(activityLog)); } catch (e) {}
  renderActivity();
}

function renderActivity() {
  var el = document.getElementById('activityList');
  if (!el) return;
  if (!activityLog.length) {
    el.innerHTML = '<div style="color:var(--fg-4);font-size:11px;padding:6px">No activity yet</div>';
    return;
  }
  el.innerHTML = '';
  var iconMap = { file: 'fa-file-code', tool: 'fa-cog', error: 'fa-exclamation-triangle', save: 'fa-save', git: 'fa-code-branch' };
  activityLog.slice(0, 30).forEach(function(a) {
    var div = document.createElement('div');
    div.className = 'activity-item kind-' + a.kind;
    var d = new Date(a.ts);
    var hh = String(d.getHours()).padStart(2, '0');
    var mm = String(d.getMinutes()).padStart(2, '0');
    var ss = String(d.getSeconds()).padStart(2, '0');
    div.innerHTML =
      '<span class="act-time">' + hh + ':' + mm + ':' + ss + '</span>' +
      '<span class="act-icon"><i class="fas ' + (iconMap[a.kind] || 'fa-circle') + '"></i></span>' +
      '<span class="act-body">' + escapeHtml(a.message) + '</span>';
    el.appendChild(div);
  });
}

/* ─── Git/GitHub Records ─── */
function logGitRecord(kind, summary, detail) {
  var rec = {
    ts: Date.now(),
    kind: String(kind || 'git'),
    summary: String(summary || '').slice(0, 200),
    detail: detail ? String(detail).slice(0, 500) : ''
  };
  gitRecords.unshift(rec);
  gitRecords = gitRecords.slice(0, 150);
  try { localStorage.setItem('ds_git_records', JSON.stringify(gitRecords)); } catch (e) {}
  renderGitRecords();
}

function renderGitRecords() {
  var el = document.getElementById('gitRecordsList');
  if (!el) return;
  if (!gitRecords.length) {
    el.innerHTML = '<div style="color:var(--fg-4);font-size:11px;padding:6px">No git activity yet</div>';
    return;
  }
  var icons = {
    clone:  { i: 'fa-cloud-download-alt', c: 'var(--blue)' },
    commit: { i: 'fa-check-circle',      c: 'var(--green)' },
    push:   { i: 'fa-upload',             c: 'var(--green)' },
    pull:   { i: 'fa-download',           c: 'var(--blue)' },
    fetch:  { i: 'fa-sync',               c: 'var(--blue)' },
    branch: { i: 'fa-code-branch',        c: '#A97BFF' },
    merge:  { i: 'fa-code-branch',        c: 'var(--yellow)' },
    tag:    { i: 'fa-tag',                c: 'var(--yellow)' },
    stash:  { i: 'fa-box',                c: 'var(--fg-2)' },
    reset:  { i: 'fa-undo',               c: 'var(--red)' },
    revert: { i: 'fa-undo',               c: 'var(--orange)' },
    identity:{ i: 'fa-id-card',           c: 'var(--blue)' },
    token:  { i: 'fa-key',                c: 'var(--yellow)' },
    error:  { i: 'fa-exclamation-triangle', c: 'var(--red)' }
  };
  var html = '';
  gitRecords.slice(0, 50).forEach(function(r) {
    var meta = icons[r.kind] || { i: 'fa-code-branch', c: 'var(--fg-3)' };
    var d = new Date(r.ts);
    var pad = function(n) { return String(n).padStart(2, '0'); };
    var stamp = d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) +
                ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes());
    html += '<div class="activity-item kind-git">' +
      '<span class="act-time" title="' + stamp + '">' + pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds()) + '</span>' +
      '<span class="act-icon" style="color:' + meta.c + '"><i class="fas ' + meta.i + '"></i></span>' +
      '<span class="act-body"><b style="color:' + meta.c + ';text-transform:uppercase;font-size:9px;letter-spacing:.5px">' + r.kind + '</b> — ' +
        escapeHtml(r.summary) +
        (r.detail ? '<br><span style="color:var(--fg-3);font-size:10px;font-family:monospace">' + escapeHtml(r.detail) + '</span>' : '') +
      '</span></div>';
  });
  el.innerHTML = html;
}

function renderChangelog() {
  var el = document.getElementById('changelogList');
  if (!el) return;
  el.innerHTML = '';
  CHANGELOG.forEach(function(entry) {
    var div = document.createElement('div');
    div.className = 'log-entry ' + (entry.type || 'feature');
    var badgeText = entry.type === 'fix' ? 'Fix' : entry.type === 'breaking' ? 'Breaking' : 'New';
    var html = '<div class="log-head">' +
                 '<span class="log-version">v' + entry.version + '</span>' +
                 '<span class="log-date">' + entry.date + '</span>' +
                 '<span class="log-badge ' + (entry.type || 'feature') + '">' + badgeText + '</span>' +
               '</div>' +
               '<ul>';
    entry.items.forEach(function(item) { html += '<li>' + item + '</li>'; });
    html += '</ul>';
    div.innerHTML = html;
    el.appendChild(div);
  });
}

function renderCurrentVersion() {
  var el = document.getElementById('logCurrentVersion');
  if (!el) return;
  fetch(API + '/api/version').then(function(r) { return r.json(); }).then(function(d) {
    var libs = d.libs || {};
    var active = Object.keys(libs).filter(function(k) { return libs[k]; }).length;
    el.innerHTML = 'v' + (d.version || '?') + ' · Node ' + (d.node || '?') + ' · ' +
                   active + '/' + Object.keys(libs).length + ' libs loaded';
  }).catch(function() {
    el.textContent = 'Backend offline';
    el.style.color = 'var(--red)';
  });
}

/* Universal copy helper */
function copyText(text, btnOrEl) {
  var onOk = function() {
    if (btnOrEl && btnOrEl.classList) {
      btnOrEl.classList.add('copied');
      var old = btnOrEl.innerHTML;
      btnOrEl.innerHTML = '<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
      setTimeout(function() {
        btnOrEl.classList.remove('copied');
        btnOrEl.innerHTML = old;
      }, 1400);
    }
    toast('Copied', 'success');
  };
  var onFail = function() { toast('Copy failed', 'error'); };
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(text).then(onOk).catch(function() {
      fallbackCopy(text) ? onOk() : onFail();
    });
  } else {
    fallbackCopy(text) ? onOk() : onFail();
  }
}

/* ═══════════════════════════════════════════════════════════════════
   AI PROVIDER
   ═══════════════════════════════════════════════════════════════════ */
function getAIProvider() { return localStorage.getItem('ai_provider') || 'deepseek'; }
function getAIEndpoint() {
  var provider = getAIProvider();
  if (provider === 'gemini') {
    var key = localStorage.getItem('gemini_key') || '';
    return { provider: 'gemini', url: 'https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=' + key, key: key };
  }
  return { provider: 'deepseek', url: 'https://api.deepseek.com/v1/chat/completions', key: localStorage.getItem('ds_key') || '' };
}

/* ═══════════════════════════════════════════════════════════════════
   TOAST
   ═══════════════════════════════════════════════════════════════════ */
function toast(msg, type) {
  type = type || 'info';
  var t = document.createElement('div');
  t.className = 'toast ' + type;
  t.textContent = msg;
  document.body.appendChild(t);
  setTimeout(function() { t.style.opacity = '0'; t.style.transition = 'opacity .3s'; }, 2800);
  setTimeout(function() { t.remove(); }, 3200);
}

/* ═══════════════════════════════════════════════════════════════════
   FS HELPERS
   ═══════════════════════════════════════════════════════════════════ */
function fsList(p) { return fetch(API + '/api/fs/list?path=' + encodeURIComponent(p || '')).then(function(r) { return r.json(); }); }
function fsRead(p) { return fetch(API + '/api/fs/read?path=' + encodeURIComponent(p)).then(function(r) { return r.json(); }); }
function fsWrite(p, content) { return fetch(API + '/api/fs/write', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ path: p, content: content }) }).then(function(r) { return r.json(); }); }
function fsDelete(p) { return fetch(API + '/api/fs/delete?path=' + encodeURIComponent(p), { method: 'DELETE' }).then(function(r) { return r.json(); }); }
function fsRename(oldPath, newPath) { return fetch(API + '/api/fs/rename', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ oldPath: oldPath, newPath: newPath }) }).then(function(r) { return r.json(); }); }
async function ghCall(endpoint, body) { var r = await fetch(API + endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {}) }); return r.json(); }

/* ═══════════════════════════════════════════════════════════════════
   LINKS API
   ═══════════════════════════════════════════════════════════════════ */
function loadLinkIndex() {
  return fetch(API + '/api/fs/links').then(function(r) { return r.json(); }).then(function(data) {
    linkIndex = {};
    (data.links || []).forEach(function(l) { linkIndex[l.name] = l; });
    return linkIndex;
  }).catch(function() { return {}; });
}
function createLink(target, name) {
  return fetch(API + '/api/fs/link', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ target: target, name: name || undefined })
  }).then(function(r) { return r.json(); });
}
function removeLink(name) {
  return fetch(API + '/api/fs/link?name=' + encodeURIComponent(name), { method: 'DELETE' })
    .then(function(r) { return r.json(); });
}

/* ═══════════════════════════════════════════════════════════════════
   DRAWERS / TABS
   ═══════════════════════════════════════════════════════════════════ */
function openDrawer(which) {
  var map = { left: 'fileTree', right: 'sidebar' };
  var el = document.getElementById(map[which]);
  if (el) el.classList.add('open');
  var bd = document.getElementById('backdrop');
  if (bd) bd.classList.add('active');
}
function closeDrawers() {
  document.getElementById('fileTree').classList.remove('open');
  document.getElementById('sidebar').classList.remove('open');
  document.getElementById('backdrop').classList.remove('active');
}
function setupPrimaryTabs() {
  document.querySelectorAll('.ptab').forEach(function(tab) {
    tab.onclick = function() { switchPrimaryPanel(this.getAttribute('data-panel')); };
  });
}
function switchPrimaryPanel(name) {
  activeTabPanel = name;
  document.querySelectorAll('.ptab').forEach(function(t) { t.classList.remove('active'); });
  document.querySelectorAll('.tab-panel').forEach(function(p) { p.classList.remove('active'); });
  var tab = document.querySelector('.ptab[data-panel="' + name + '"]');
  var panel = document.getElementById('panel-' + name);
  if (tab) tab.classList.add('active');
  if (panel) panel.classList.add('active');
  if (name === 'editor' && !monacoLoaded) loadMonaco();
  if (name === 'terminal' && term && termAddons.fit) {
    setTimeout(function() { try { termAddons.fit.fit(); } catch (e) {} }, 200);
  }
  if (name === 'editor') showTabBadge('editor', false);
  if (name === 'terminal') showTabBadge('terminal', false);
}
function showTabBadge(tabName, show) {
  var badge = document.getElementById(tabName + 'Badge');
  if (badge) badge.className = 'tab-badge' + (show ? ' show' : '');
}

/* ═══════════════════════════════════════════════════════════════════
   FILE TREE
   ═══════════════════════════════════════════════════════════════════ */
function refreshTree() {
  loadLinkIndex().then(function() {
    treeCache = {};
    loadTreeLevel('');
  });
}
function loadTreeLevel(parentPath) { fsList(parentPath).then(function(items) { treeCache[parentPath] = items; renderTree(); }); }
function renderTree() {
  var body = document.getElementById('ftBody');
  body.innerHTML = '';
  var rootItems = treeCache[''] || [];
  if (!rootItems.length) {
    body.innerHTML = '<div class="ft-empty">Empty workspace<br><br>Use <b>Templates</b>, <b>Generate</b>, or click the <b>🔗</b> button above to link a folder from your phone</div>';
    return;
  }
  renderItems(rootItems, 0, body);
}
function renderItems(items, depth, container) {
  items.forEach(function(it) {
    var div = document.createElement('div');
    var isExpanded = expandedFolders[it.path];
    div.className = 'tree-item' + (openFile === it.path ? ' active' : '');
    div.style.paddingLeft = (10 + depth * 14) + 'px';

    var chevronHtml = it.isDir
      ? '<i class="fas fa-chevron-right chevron' + (isExpanded ? ' open' : '') + '"></i>'
      : '<span class="chevron"></span>';

    var iconClass;
    if (it.isLink) iconClass = isExpanded ? 'fa-folder-open' : 'fa-folder';
    else if (it.isDir) iconClass = isExpanded ? 'fa-folder-open' : 'fa-folder';
    else iconClass = getFileIcon(it.name);
    var iconColor = it.isLink ? 'color:#58a6ff' : fileIconColor(it.name, it.isDir);

    var linkBadge = it.isLink
      ? '<span class="file-badge link" title="Linked from ' + (linkIndex[it.name] ? linkIndex[it.name].target : 'external') + '" style="background:#1f6feb22;color:var(--blue)">🔗</span>'
      : '';

    var modBadge = '';
    if (!it.isDir && modifiedFiles[it.path]) modBadge = '<span class="file-badge modified">M</span>';

    div.innerHTML = chevronHtml + '<i class="fas ' + iconClass + ' tree-icon" style="' + iconColor + '"></i>' +
                    '<span class="tree-name">' + escAttr(it.name) + '</span>' + linkBadge + modBadge;

    div.onclick = function() {
      if (it.isDir) {
        if (expandedFolders[it.path]) { delete expandedFolders[it.path]; renderTree(); }
        else { expandedFolders[it.path] = true; if (!treeCache[it.path]) loadTreeLevel(it.path); else renderTree(); }
      } else { openFileFromTree(it.path); if (isMobile) closeDrawers(); }
    };
    var pressTimer = null;
    div.addEventListener('touchstart', function(e) {
      pressTimer = setTimeout(function() { showContextMenu(it, e); if (navigator.vibrate) navigator.vibrate(30); }, 550);
    }, { passive: true });
    div.addEventListener('touchend', function() { clearTimeout(pressTimer); });
    div.addEventListener('touchmove', function() { clearTimeout(pressTimer); });
    div.addEventListener('contextmenu', function(e) { e.preventDefault(); showContextMenu(it, e); });
    container.appendChild(div);
    if (it.isDir && isExpanded && treeCache[it.path]) renderItems(treeCache[it.path], depth + 1, container);
  });
}
function getFileIcon(name) {
  var ext = name.split('.').pop().toLowerCase();
  if (['kt','kts','java','py','js','ts','jsx','tsx','dart','rs','go','swift','c','cpp','h','html','htm','css','scss','sass','json','xml','yaml','yml','sh','bash','toml','ini','conf','gradle'].includes(ext)) return 'fa-file-code';
  if (['md','markdown','txt','rst'].includes(ext)) return 'fa-file-alt';
  if (['png','jpg','jpeg','gif','svg','webp','ico','bmp'].includes(ext)) return 'fa-file-image';
  if (['mp4','webm','avi','mov','mkv'].includes(ext)) return 'fa-file-video';
  if (['mp3','wav','ogg','flac','m4a'].includes(ext)) return 'fa-file-audio';
  if (['zip','tar','gz','rar','7z','xz','bz2'].includes(ext)) return 'fa-file-archive';
  if (['pdf'].includes(ext)) return 'fa-file-pdf';
  if (['csv','xls','xlsx'].includes(ext)) return 'fa-file-excel';
  if (['doc','docx','odt'].includes(ext)) return 'fa-file-word';
  return 'fa-file';
}
function fileIconColor(name, isDir) {
  if (isDir) return 'color:var(--blue)';
  var ext = name.split('.').pop().toLowerCase();
  if (['py'].includes(ext)) return 'color:#3572A5';
  if (['js','jsx','mjs','cjs'].includes(ext)) return 'color:#f1e05a';
  if (['ts','tsx'].includes(ext)) return 'color:#3178c6';
  if (['kt','kts'].includes(ext)) return 'color:#A97BFF';
  if (['java'].includes(ext)) return 'color:#b07219';
  if (['dart'].includes(ext)) return 'color:#00B4AB';
  if (['rs'].includes(ext)) return 'color:#dea584';
  if (['go'].includes(ext)) return 'color:#00ADD8';
  if (['swift'].includes(ext)) return 'color:#ffac45';
  if (['html','htm'].includes(ext)) return 'color:#e34c26';
  if (['css','scss','sass'].includes(ext)) return 'color:#563d7c';
  if (['json'].includes(ext)) return 'color:#cbcb41';
  if (['md','markdown'].includes(ext)) return 'color:#519aba';
  if (['sh','bash'].includes(ext)) return 'color:#89e051';
  if (['yml','yaml','toml','ini','conf'].includes(ext)) return 'color:#6d8086';
  if (['png','jpg','jpeg','gif','svg','webp'].includes(ext)) return 'color:#a074c4';
  return 'color:var(--orange)';
}

/* ═══════════════════════════════════════════════════════════════════
   LINK FOLDER MODAL
   ═══════════════════════════════════════════════════════════════════ */
function openLinkFolderModal() {
  lfSelectedPath = '';
  lfCurrentPath = '';
  lfCurrentParent = null;
  document.getElementById('lfNameInput').value = '';
  document.getElementById('lfStatus').textContent = '';
  document.getElementById('lfLinkBtn').disabled = true;
  document.getElementById('linkFolderModal').classList.add('active');
  browseTo('');
}
function closeLinkFolderModal() {
  document.getElementById('linkFolderModal').classList.remove('active');
}
function browseTo(p) {
  var url = API + '/api/fs/browse' + (p ? '?path=' + encodeURIComponent(p) : '');
  var list = document.getElementById('lfList');
  list.innerHTML = '<div style="padding:16px;text-align:center;color:var(--fg-3);font-size:12px">Loading…</div>';
  fetch(url).then(function(r) { return r.json(); }).then(function(data) {
    if (data.error) {
      list.innerHTML = '<div style="padding:16px;color:var(--red);font-size:12px">' + data.error + '</div>';
      return;
    }
    if (data.roots) lfAllowedRoots = data.items.map(function(i) { return i.path; });
    lfCurrentPath = data.path || '';
    lfCurrentParent = data.parent;
    renderBreadcrumb();
    renderFolderList(data.items || [], data.roots);
  }).catch(function(e) {
    list.innerHTML = '<div style="padding:16px;color:var(--red);font-size:12px">Error: ' + e.message + '</div>';
  });
}
function renderBreadcrumb() {
  var bc = document.getElementById('lfBreadcrumb');
  bc.innerHTML = '';
  if (!lfCurrentPath) {
    bc.innerHTML = '<span style="color:var(--fg-3)">Pick a starting location</span>';
    return;
  }
  var parts = lfCurrentPath.split('/').filter(Boolean);
  var acc = '';
  parts.forEach(function(part, i) {
    acc += '/' + part;
    var span = document.createElement('span');
    span.textContent = part;
    span.style.cursor = 'pointer';
    span.style.color = 'var(--blue)';
    span.onclick = function() { browseTo(acc); };
    bc.appendChild(span);
    if (i < parts.length - 1) {
      var sep = document.createElement('span');
      sep.textContent = '/';
      sep.style.color = 'var(--fg-4)';
      bc.appendChild(sep);
    }
  });
}
function renderFolderList(items, isRoots) {
  var list = document.getElementById('lfList');
  list.innerHTML = '';

  if (!isRoots && lfCurrentPath) {
    var useBtn = document.createElement('div');
    useBtn.style.cssText = 'padding:10px 12px;background:#1f6feb22;border-radius:6px;margin:4px 0;cursor:pointer;font-size:12px;color:var(--blue);font-weight:600';
    useBtn.innerHTML = '<i class="fas fa-check-circle"></i> Use this folder (' + (lfCurrentPath.split('/').pop() || lfCurrentPath) + ')';
    useBtn.onclick = function() { selectFolder(lfCurrentPath); };
    list.appendChild(useBtn);
  }

  if (!items.length) {
    var empty = document.createElement('div');
    empty.style.cssText = 'padding:16px;text-align:center;color:var(--fg-4);font-size:12px';
    empty.textContent = 'No subfolders';
    list.appendChild(empty);
    return;
  }

  items.forEach(function(it) {
    var row = document.createElement('div');
    row.style.cssText = 'padding:10px 12px;display:flex;align-items:center;gap:10px;cursor:pointer;border-radius:6px;font-size:13px';
    row.onmouseenter = function() { row.style.background = 'var(--bg-3)'; };
    row.onmouseleave = function() { row.style.background = 'transparent'; };
    row.innerHTML = '<i class="fas fa-folder" style="color:var(--blue);width:16px"></i>' +
                    '<span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' + escAttr(it.name) + '</span>' +
                    '<i class="fas fa-chevron-right" style="color:var(--fg-4);font-size:10px"></i>';
    if (isRoots) { row.title = it.path; }
    row.onclick = function() { browseTo(it.path); };
    list.appendChild(row);
  });
}
function selectFolder(path) {
  lfSelectedPath = path;
  var nameInput = document.getElementById('lfNameInput');
  if (!nameInput.value) {
    nameInput.placeholder = 'Defaults to "' + (path.split('/').pop() || 'link') + '"';
  }
  document.getElementById('lfLinkBtn').disabled = false;
  document.getElementById('lfStatus').textContent = '📁 Selected: ' + path;
  document.getElementById('lfStatus').style.color = 'var(--blue)';
}
function doCreateLink() {
  if (!lfSelectedPath) { toast('Select a folder first', 'error'); return; }
  var name = (document.getElementById('lfNameInput').value || '').trim();
  var btn = document.getElementById('lfLinkBtn');
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Linking…';
  createLink(lfSelectedPath, name || undefined).then(function(r) {
    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-link"></i> Link this folder';
    if (r.ok) {
      toast('Linked: ' + r.link.name, 'success');
      logActivity('file', 'Linked external folder: ' + r.link.name);
      closeLinkFolderModal();
      refreshTree();
      loadLinksList();
    } else {
      document.getElementById('lfStatus').textContent = '❌ ' + (r.error || 'Link failed');
      document.getElementById('lfStatus').style.color = 'var(--red)';
    }
  }).catch(function(e) {
    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-link"></i> Link this folder';
    document.getElementById('lfStatus').textContent = '❌ ' + e.message;
    document.getElementById('lfStatus').style.color = 'var(--red)';
  });
}
function loadLinksList() {
  var el = document.getElementById('linksList');
  if (!el) return;
  fetch(API + '/api/fs/links').then(function(r) { return r.json(); }).then(function(data) {
    var links = data.links || [];
    if (!links.length) {
      el.innerHTML = '<div style="color:var(--fg-4);font-size:11px;padding:6px">No external folders linked yet.</div>';
      return;
    }
    el.innerHTML = '';
    links.forEach(function(l) {
      var row = document.createElement('div');
      row.className = 'env-row';
      row.style.alignItems = 'center';
      var status = l.broken ? '⚠️' : (l.targetExists ? '✅' : '❌');
      var bg = l.broken ? '#9e6a0322' : (l.targetExists ? '#23863622' : '#da363322');
      row.style.background = bg;
      row.style.padding = '6px 10px';
      row.style.borderRadius = '6px';
      row.innerHTML = '<span style="flex:1;font-size:11px;line-height:1.4;overflow:hidden">' +
        '<b style="color:var(--fg-1)">' + status + ' ' + l.name + '</b><br>' +
        '<span style="color:var(--fg-3);font-family:monospace;font-size:10px;word-break:break-all">' + l.target + '</span>' +
      '</span>';
      var btn = document.createElement('button');
      btn.className = 'btn';
      btn.style.cssText = 'padding:6px 10px;font-size:11px';
      btn.innerHTML = '<i class="fas fa-unlink"></i>';
      btn.title = 'Unlink (folder is preserved)';
      btn.onclick = function() {
        showConfirm('Unlink "' + l.name + '"?',
          'The external folder is NOT deleted — only the link inside the workspace is removed.',
          function() {
            removeLink(l.name).then(function(r) {
              if (r.ok) { toast('Unlinked', 'success'); logActivity('file', 'Unlinked: ' + l.name); refreshTree(); loadLinksList(); }
              else toast(r.error || 'Unlink failed', 'error');
              hideConfirm();
            });
          }, 'Unlink');
      };
      row.appendChild(btn);
      el.appendChild(row);
    });
  }).catch(function() {
    el.innerHTML = '<div style="color:var(--red);font-size:11px">Backend offline</div>';
  });
}

/* ═══════════════════════════════════════════════════════════════════
   CONTEXT MENU / CONFIRM
   ═══════════════════════════════════════════════════════════════════ */
function showContextMenu(it, e) {
  ctxItem = it;
  var m = document.getElementById('ctxMenu');
  document.getElementById('ctxTitle').textContent = it.name;
  document.getElementById('ctxBookmark').innerHTML = '<i class="' + (bookmarks.indexOf(it.path) >= 0 ? 'fas' : 'far') + ' fa-star"></i> ' + (bookmarks.indexOf(it.path) >= 0 ? 'Remove bookmark' : 'Bookmark');

  var unlinkEl = document.getElementById('ctxUnlink');
  if (unlinkEl) { unlinkEl.style.display = it.isLink ? 'flex' : 'none'; }

  var rect = (e && e.target && e.target.getBoundingClientRect) ? e.target.getBoundingClientRect() : { left: 20, top: 150, bottom: 200 };
  var left = Math.min(rect.left, window.innerWidth - 240);
  var top = rect.bottom + 5;
  if (top + 480 > window.innerHeight - 10) top = Math.max(10, rect.top - 480);
  m.style.left = Math.max(10, left) + 'px';
  m.style.top = top + 'px';
  m.classList.add('active');
}
function hideContextMenu() { document.getElementById('ctxMenu').classList.remove('active'); ctxItem = null; }

function showConfirm(title, msg, cb, okLabel) {
  document.getElementById('confirmTitle').textContent = title;
  document.getElementById('confirmMsg').textContent = msg;
  document.getElementById('confirmOk').textContent = okLabel || 'Confirm';
  confirmCallback = cb;
  document.getElementById('confirmModal').classList.add('active');
}
function hideConfirm() { document.getElementById('confirmModal').classList.remove('active'); confirmCallback = null; }

/* ═══════════════════════════════════════════════════════════════════
   FILE OPERATIONS
   ═══════════════════════════════════════════════════════════════════ */
function renameItem(item) {
  var newName = window.prompt('Rename to:', item.name);
  if (!newName || newName === item.name) { hideContextMenu(); return; }
  if (item.isLink) { toast('Cannot rename a linked folder — unlink and re-link instead', 'warn'); hideContextMenu(); return; }
  var dir = item.path.split('/').slice(0, -1).join('/');
  var newPath = dir ? dir + '/' + newName : newName;
  fsRename(item.path, newPath).then(function(r) {
    if (r.ok) { toast('Renamed', 'success'); logActivity('file', 'Renamed: ' + item.path + ' → ' + newPath); refreshTree(); if (openFile === item.path) { openFile = newPath; renderEditorTabs(); } }
    else toast('Rename failed: ' + (r.error || ''), 'error');
    hideContextMenu();
  });
}
function detectLangForPath(path) {
  var ext = path.split('.').pop().toLowerCase();
  var map = { kt:'kotlin', kts:'kotlin', py:'python', dart:'dart', js:'javascript', jsx:'javascript', mjs:'javascript', cjs:'javascript', html:'html', htm:'html', css:'css', scss:'scss', sass:'scss', rs:'rust', go:'go', java:'java', ts:'typescript', tsx:'typescript', json:'json', xml:'xml', yaml:'yaml', yml:'yaml', toml:'ini', ini:'ini', md:'markdown', sh:'shell', bash:'shell', c:'c', h:'c', cpp:'cpp', hpp:'cpp', swift:'swift', txt:'plaintext' };
  return map[ext] || 'plaintext';
}
function trackRecent(path) {
  recentFiles = recentFiles.filter(function(p) { return p !== path; });
  recentFiles.unshift(path);
  recentFiles = recentFiles.slice(0, 10);
  localStorage.setItem('ds_recent', JSON.stringify(recentFiles));
}
function updateCtxIndicator() {
  var el = document.getElementById('ctxIndicator');
  if (!el) return;
  if (openFile) {
    el.textContent = '📄 ' + openFile.split('/').pop() + (fileModified ? ' ●' : '');
    el.className = 'ctx-indicator' + (fileModified ? ' modified' : '');
  } else {
    el.textContent = '📄 No file';
    el.className = 'ctx-indicator';
  }
  var badge = document.getElementById('contextBadge');
  var ctxInfo = document.getElementById('contextInfo');
  if (badge && ctxInfo) {
    if (currentProject) { badge.style.display = 'inline-flex'; ctxInfo.textContent = currentProject; }
    else badge.style.display = 'none';
  }
}
function openFileFromTree(path) {
  if (openFile && fileModified && editor) modifiedFiles[openFile] = true;
  openFile = path;
  activeTabPath = path;
  trackRecent(path);
  if (openTabs.indexOf(path) < 0) openTabs.push(path);
  renderEditorTabs();
  fsRead(path).then(function(r) {
    fileContent = r.content || '';
    fileModified = false;
    if (!monacoLoaded) {
      switchPrimaryPanel('editor');
      var iv = setInterval(function() {
        if (monacoLoaded && editor) {
          clearInterval(iv);
          editor.setValue(fileContent);
          monaco.editor.setModelLanguage(editor.getModel(), detectLangForPath(path));
        }
      }, 100);
    } else if (editor && window.monaco) {
      editor.setValue(fileContent);
      monaco.editor.setModelLanguage(editor.getModel(), detectLangForPath(path));
    }
    updateCtxIndicator();
    var topFolder = path.split('/')[0];
    if (topFolder && topFolder !== currentProject) setCurrentProject(topFolder);
    refreshTree();
  });
}
function renderEditorTabs() {
  var bar = document.getElementById('editorTabsBar');
  bar.innerHTML = '';
  if (!openTabs.length) { bar.style.display = 'none'; return; }
  bar.style.display = 'flex';
  openTabs.forEach(function(p) {
    var tab = document.createElement('div');
    tab.className = 'editor-tab' + (p === activeTabPath ? ' active' : '');
    var modifiedDot = modifiedFiles[p] ? '<span class="modified-dot"></span>' : '';
    tab.innerHTML = '<i class="fas ' + getFileIcon(p.split('/').pop()) + '"></i> ' + p.split('/').pop() + modifiedDot + '<span class="close-x">&times;</span>';
    tab.onclick = function(e) {
      if (e.target.classList.contains('close-x')) {
        e.stopPropagation();
        openTabs = openTabs.filter(function(x) { return x !== p; });
        if (activeTabPath === p) {
          activeTabPath = openTabs[openTabs.length - 1] || null;
          if (activeTabPath) openFileFromTree(activeTabPath);
          else { openFile = null; fileContent = ''; if (editor) editor.setValue(''); updateCtxIndicator(); }
        }
        renderEditorTabs();
        return;
      }
      if (p !== activeTabPath) openFileFromTree(p);
    };
    bar.appendChild(tab);
  });
}
function saveFile() {
  if (!openFile) { toast('No file open', 'error'); return; }
  fsWrite(openFile, fileContent).then(function() {
    toast('Saved ' + openFile.split('/').pop(), 'success');
    logActivity('save', 'Saved ' + openFile);
    fileModified = false;
    delete modifiedFiles[openFile];
    updateCtxIndicator();
    renderEditorTabs();
    refreshTree();
    if (autoGitEnabled && currentProject) {
      fetch(API + '/api/git/auto-commit', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ cwd: currentProject, file: openFile }) })
        .then(function(r) { return r.json(); })
        .then(function(d) { if (d.ok) logGitRecord('commit', 'Auto-commit: ' + openFile.split('/').pop()); })
        .catch(function() {});
    }
  }).catch(function() { toast('Save failed', 'error'); });
}
function saveAsFile() {
  if (!openFile) { toast('No file open', 'error'); return; }
  var newPath = window.prompt('Save as (relative path):', openFile);
  if (!newPath || newPath === openFile) return;
  newPath = newPath.replace(/^\/+/, '').replace(/\/+$/, '').replace(/\/{2,}/g, '/');
  fsWrite(newPath, fileContent).then(function(r) {
    if (r.ok) { toast('Saved as ' + newPath, 'success'); logActivity('save', 'Saved as ' + newPath); refreshTree(); openFileFromTree(newPath); }
    else toast('Save As failed', 'error');
  });
}
function reloadFile() {
  if (!openFile) return;
  if (fileModified) showConfirm('Reload?', 'Unsaved changes will be lost.', function() { doReloadFile(); hideConfirm(); }, 'Reload');
  else doReloadFile();
}
function doReloadFile() {
  fsRead(openFile).then(function(r) {
    fileContent = r.content || '';
    fileModified = false;
    delete modifiedFiles[openFile];
    if (editor) editor.setValue(fileContent);
    updateCtxIndicator();
    renderEditorTabs();
    toast('Reloaded', 'success');
  });
}
function closeCurrentTab() {
  if (!activeTabPath) return;
  openTabs = openTabs.filter(function(x) { return x !== activeTabPath; });
  activeTabPath = openTabs[openTabs.length - 1] || null;
  if (activeTabPath) openFileFromTree(activeTabPath);
  else { openFile = null; fileContent = ''; if (editor) editor.setValue(''); updateCtxIndicator(); }
  renderEditorTabs();
}

/* ═══════════════════════════════════════════════════════════════════
   NEW FILE MODAL
   ═══════════════════════════════════════════════════════════════════ */
function openNewFileModal(prefix) {
  newFilePrefix = prefix || '';
  var m = document.getElementById('newFileModal');
  var inp = document.getElementById('newFilePath');
  var lbl = document.getElementById('newFilePrefixLabel');
  if (!m || !inp) return;
  lbl.textContent = prefix ? 'Save into: ' + prefix + '/' : 'Folder';
  inp.value = '';
  inp.placeholder = prefix ? 'filename.py (subfolders allowed)' : 'e.g. src/utils/helper.py';
  m.classList.add('active');
  setTimeout(function() { inp.focus(); }, 150);
}
function closeNewFileModal() { document.getElementById('newFileModal').classList.remove('active'); }
function createFromModal() {
  var raw = (document.getElementById('newFilePath').value || '').trim();
  if (!raw) { toast('Enter a filename', 'error'); return; }
  raw = raw.replace(/^\/+/, '').replace(/\/+$/, '').replace(/\/{2,}/g, '/');
  var fullPath = newFilePrefix ? newFilePrefix + '/' + raw : raw;
  var base = fullPath.split('/').pop();
  if (!base || base === '.' || base === '..') { toast('Invalid filename', 'error'); return; }
  closeNewFileModal();
  fsWrite(fullPath, '').then(function(r) {
    if (r && r.ok === false) { toast('Create failed: ' + (r.error || 'unknown'), 'error'); return; }
    toast('Created ' + fullPath, 'success');
    logActivity('file', 'Created ' + fullPath);
    var parts = fullPath.split('/');
    var acc = '';
    for (var i = 0; i < parts.length - 1; i++) {
      acc = acc ? acc + '/' + parts[i] : parts[i];
      expandedFolders[acc] = true;
      if (!treeCache[acc]) loadTreeLevel(acc);
    }
    refreshTree();
    openFileFromTree(fullPath);
  }).catch(function(e) { toast('Create failed: ' + e.message, 'error'); });
}
function setupNewFileModal() {
  document.getElementById('modalCancel').onclick = closeNewFileModal;
  document.getElementById('modalCreate').onclick = createFromModal;
  document.getElementById('newFilePath').onkeydown = function(e) { if (e.key === 'Enter') { e.preventDefault(); createFromModal(); } };
}

/* ═══════════════════════════════════════════════════════════════════
   CURRENT PROJECT
   ═══════════════════════════════════════════════════════════════════ */
function setCurrentProject(name) {
  currentProject = name;
  localStorage.setItem('ds_current_project', name || '');
  var sel = document.getElementById('workspaceSelector');
  if (sel) sel.value = name || '';
  fetch(API + '/api/detect-language?path=' + encodeURIComponent(name))
    .then(function(r) { return r.json(); })
    .then(function(data) {
      currentLang = data;
      var badge = document.getElementById('langBadge');
      if (badge && currentLang.lang !== 'unknown') { badge.textContent = currentLang.lang.toUpperCase(); badge.style.display = 'inline-block'; }
    }).catch(function() {});
  updateChatWarn();
  updateCtxIndicator();
}
function updateChatWarn() {
  var badge = document.getElementById('chatWarnBadge');
  if (!badge) return;
  if (!currentProject) { badge.innerHTML = '<i class="fas fa-exclamation-triangle"></i> Select a project'; badge.style.display = 'flex'; }
  else badge.style.display = 'none';
}
function loadWorkspaceSelector() {
  var sel = document.getElementById('workspaceSelector');
  if (!sel) return;
  fsList('').then(function(items) {
    var dirs = items.filter(function(i) { return i.isDir; });
    sel.innerHTML = '<option value="">-- select a project --</option>';
    dirs.forEach(function(d) {
      var opt = document.createElement('option');
      opt.value = d.name;
      opt.textContent = d.name + (d.isLink ? '  🔗' : '');
      if (d.name === currentProject) opt.selected = true;
      sel.appendChild(opt);
    });
    if (currentProject) sel.value = currentProject;
    updateChatWarn();
  });
  sel.onchange = function() {
    var newProj = this.value;
    if (newProj === currentProject) return;
    var dirty = Object.keys(modifiedFiles).length > 0;
    if (dirty) {
      var prev = currentProject;
      this.value = prev;
      showConfirm('Unsaved changes', 'You have ' + Object.keys(modifiedFiles).length + ' modified file(s). Switch projects anyway?',
        function() { modifiedFiles = {}; setCurrentProject(newProj); hideConfirm(); }, 'Switch');
    } else setCurrentProject(newProj);
  };
}

